<%= stylesheet_link_tag 'new', media: "all" %>

<div class="new-page">

  <h3 class="new-page-title">投稿編集ページ</h3>

  <div class="post-container">

    <p class="title">ゲーム情報を編集する</p>

    <%= form_for(@tweet) do |f| %>

      <div class="form-intro">
        投稿内容を変更できます
      </div>


      <!-- ゲームタイトル -->
      <div class="field">
        <%= f.label :ゲームタイトル, class: "field-label" %>

        <%= f.text_field :title,
                         class: "form-input",
                         placeholder: "ゲームタイトルを入力" %>
      </div>


      <!-- プレイ時間 -->
      <div class="field">
        <%= f.label :playtime,
                    '1回あたりのプレイ時間',
                    class: "field-label" %>

        <div class="playtime-input-wrap">

          <%= f.number_field :playtime,
                             class: "form-input playtime-input",
                             min: 0 %>

          <span class="playtime-unit">分</span>

        </div>
      </div>


      <!-- 現在のゲーム画像 -->
      <% if @tweet.photo.attached? %>

        <div class="field">

          <p class="field-label">
            現在のゲーム画像
          </p>

          <div class="edit-current-image">
            <%= image_tag @tweet.photo %>
          </div>

        </div>

      <% end %>


      <!-- ゲーム画像変更 -->
      <div class="field">

        <%= f.label :ゲームプレイ画像,
                    class: "field-label" %>

        <%= f.file_field :photo,
                         class: "form-file" %>

        <p class="edit-image-note">
          画像を変更しない場合は、何も選択せずに更新してください。
        </p>

      </div>


      <!-- ゲーム内容 -->
      <div class="field">

        <%= f.label :ゲーム内容,
                    class: "field-label" %>

        <%= f.text_area :game_detail,
                        class: "form-textarea",
                        placeholder: "ゲームの内容やおすすめポイントを入力" %>

      </div>


      <!-- タグ -->
      <div class="field tag-field">

        <p class="field-label">
          タグ
        </p>

        <div class="form-tag-list">

          <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |tag| %>

            <label class="form-tag-option">

              <%= tag.check_box class: "form-tag-checkbox" %>

              <span class="form-tag-label">
                <%= tag.text %>
              </span>

            </label>

          <% end %>

        </div>

      </div>


      <!-- 更新ボタン -->
      <div class="submit-area">

        <%= f.submit "更新する",
                     class: "post-submit-button" %>

      </div>

    <% end %>


    <!-- 戻る -->
    <div class="back-link-area">

      <%= link_to "← 詳細ページに戻る",
                  tweet_path(@tweet.id),
                  class: "back-link" %>

    </div>

  </div>

</div>